{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src/ConsoleForge",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "docs/**/*.{md,yml}",
          "api/**/*.{md,yml}",
          "CHANGELOG.md"
        ]
      },
      {
        "src": "src/ConsoleForge.SourceGen",
        "files": [
          "README.md"
        ],
        "dest": "docs"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/consoleforge"
    ],
    "globalMetadata": {
      "_appName": "ConsoleForge",
      "_appTitle": "ConsoleForge",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/favicon.png",
      "_enableSearch": true,
      "_appFooter": "<div class=\"cf-footer\"><span class=\"cf-mark\">ConsoleForge</span><span>MIT licensed</span><a href=\"https://github.com/Popplywop/ConsoleForge\">Source</a><a href=\"https://www.nuget.org/packages/ConsoleForge\">NuGet</a><a href=\"CHANGELOG.html\">Changelog</a></div>"
    }
  }
}
